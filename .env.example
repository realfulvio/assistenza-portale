# Copia questo file in .env e compila i valori. NON pubblicare mai il file .env.
# Sul server: sudo chown portale:portale .env && sudo chmod 600 .env

# --- Generale ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Percorso sotto cui il portale e' pubblicato dal reverse proxy (es. https://portale.tuoente.it/assistenza)
BASE_PATH=/assistenza
# Indirizzo pubblico, senza barra finale e senza BASE_PATH
PUBLIC_URL=https://portale.esempio.it
# Stringa casuale lunga (almeno 24 caratteri), ad esempio: openssl rand -hex 32
SESSION_SECRET=sostituisci-con-una-stringa-casuale-lunga
# Durata della sessione in ore
SESSION_HOURS=8
# Preferenze personali: directory persistente scrivibile dall'utente del servizio.
# Predefinita: data/preferences (data/preferences-demo in demo).
# PREFERENCES_DIR=/var/lib/portale-assistenza/preferences
# 1 = invia l'header HSTS (solo con certificato definitivo e fidato)
HSTS=0
# Nome del parametro con il nome del PC (es. ...?pc=NOMEPC, vedi docs/icona-desktop.md); vuoto = disattivato
PC_PARAM=pc

# --- Modalita' demo -----------------------------------------------------------
# 1 = GLPI finto e accesso simulato, per provare il portale senza GLPI ne' Microsoft. MAI in produzione.
DEMO=0

# --- Accesso (OpenID Connect) -------------------------------------------------
# Microsoft Entra ID: https://login.microsoftonline.com/<ID-TENANT>/v2.0
OIDC_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=valore-fittizio
OIDC_REDIRECT_URI=https://portale.esempio.it/assistenza/auth/callback
OIDC_SCOPE=openid profile email
# Facoltativi (lasciare vuoti per non usarli):
# solo utenti di questo tenant Entra (claim "tid"), di solito uguale all'ID nel campo OIDC_ISSUER
OIDC_ALLOWED_TENANT=
# solo membri di questo gruppo (claim "groups": va abilitato nella registrazione dell'app)
OIDC_ALLOWED_GROUP=
# solo email di questo dominio (es. esempio.it)
OIDC_ALLOWED_EMAIL_DOMAIN=

# --- GLPI ----------------------------------------------------------------------
# Indirizzo raggiungibile dal server del portale (se GLPI e' sulla stessa macchina: http://127.0.0.1)
GLPI_URL=http://127.0.0.1
GLPI_APP_TOKEN=valore-fittizio
GLPI_USER_TOKEN=valore-fittizio
# Facoltativi (id numerici di GLPI; vuoti = comportamento predefinito)
GLPI_ENTITY_ID=
# Gruppo tecnico assegnato dal portale alla creazione. VUOTO = il ticket nasce «Nuova» senza assegnatario
# (controlla anche regole e assegnazione automatica di GLPI: docs/glpi.md)
GLPI_GROUP_ID=
GLPI_SELF_SERVICE_PROFILE_ID=
# Come ricavare nome e cognome dei nuovi utenti: nome.cognome | cognome.nome | vuoto (usa il nome visualizzato)
GLPI_FORMATO_EMAIL=
GLPI_TIMEOUT_MS=15000

# --- Limiti --------------------------------------------------------------------
MAX_FILES=5
MAX_FILE_MB=10
MAX_TICKETS_PER_HOUR=10

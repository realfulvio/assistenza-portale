# Copia in /etc/apache2/glpi-oidc-secret.conf, compila e proteggi:
#   sudo chown root:root /etc/apache2/glpi-oidc-secret.conf && sudo chmod 600 /etc/apache2/glpi-oidc-secret.conf
# Per Microsoft Entra ID l'issuer e' https://login.microsoftonline.com/<ID-TENANT>/v2.0
OIDCProviderMetadataURL https://login.microsoftonline.com/<ID-TENANT>/v2.0/.well-known/openid-configuration
OIDCClientID <ID-APPLICAZIONE>
OIDCClientSecret <CLIENT-SECRET>
# Stringa casuale lunga, per esempio generata con: openssl rand -hex 32
OIDCCryptoPassphrase <STRINGA-CASUALE>

  "author": "Luca Accorsi (https://github.com/realfulvio)",
  "license": "EUPL-1.2",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realfulvio/assistenza-portale.git"
  },
  "keywords": [
    "glpi",
    "helpdesk",
    "pubblica-amministrazione",
    "comuni",
    "openid-connect",
    "microsoft-entra"

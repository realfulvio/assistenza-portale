    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "memorystore": "^1.6.8",
    "multer": "^2.4.0",
    "openid-client": "^5.7.1",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0"
